{
  "name": "teal-tidal",
  "version": "0.1.1",
  "description": "A tiny TIDAL to teal.fm browser extension built with TypeScript and atcute",
  "scripts": {
    "build": "tsdown && tailwindcss -i src/popup.css -o dist/popup.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@atcute/atproto": "^4.0.5",
    "@atcute/client": "^5.1.2",
    "@atcute/password-session": "^1.0.2",
    "@atcute/tid": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "linkedom": "^0.18.15",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
