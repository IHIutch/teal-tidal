{
  "manifest_version": 3,
  "name": "Teal Tidal",
  "version": "0.1.1",
  "description": "Track TIDAL web player listens directly in your AT Protocol account for teal.fm.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://bsky.social/*", "https://*.host.bsky.network/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Teal Tidal", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{
    "matches": ["https://tidal.com/*", "https://www.tidal.com/*", "https://listen.tidal.com/*", "https://www.listen.tidal.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
