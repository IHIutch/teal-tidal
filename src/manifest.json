{
  "manifest_version": 3,
  "name": "Teal Tidal",
  "version": "0.1.0",
  "description": "Track TIDAL web player listens directly in your AT Protocol account for teal.fm.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Teal Tidal" },
  "content_scripts": [{
    "matches": ["https://listen.tidal.com/*", "https://www.listen.tidal.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
